<Window x:Class="katalog_produktow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:katalog_produktow"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20, 20, 20,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition  Width="Auto"/>
            <ColumnDefinition  Width="*"/>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nazwa produkty"  Margin="0,0,10,0" VerticalAlignment="Center" />
        <TextBox x:Name="NazwaTextBoxa" Grid.Row="0" Grid.Column="1" Margin="0, 5, 0, 10" VerticalAlignment="Center"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Cena"  VerticalAlignment="Center"/>
        <TextBox x:Name="CenaTextBoxa" Grid.Row="1" Grid.Column="1" Margin="0, 5, 0, 10" VerticalAlignment="Center"/>
        
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ilość Produktu"  VerticalAlignment="Center"/>
        <TextBox x:Name="IloscTextBoxa" Grid.Row="2" Grid.Column="1" Margin="0, 5, 0, 10" VerticalAlignment="Center"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Kategoria"  VerticalAlignment="Center"/>
        <ComboBox x:Name="KategorieComboBox" Grid.Row="3" Grid.Column="1" Margin="0, 5, 0, 10" VerticalAlignment="Center" />


        <TextBlock Grid.Row="4" Grid.Column="0" Text="Promocja" VerticalAlignment="Center"/>
        <CheckBox x:Name="PromocjeCheckBox" Grid.Row="4" Grid.Column="1" Margin="0, 5, 0, 10" VerticalAlignment="Center"/>

        <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ObliczButton" Content="Oblicz" Click="Oblicz"/>
        <TextBlock x:Name="WynicBlock" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="6" FontSize="16" />
        
        <Button Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" x:Name="DodajProduktButton" Content="Dodaj Produkt" Click="DodajProdukt"/>

        <ListBox x:Name="ListaProduktow" ItemsSource="{Binding produkty}" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Margin="0, 12, 0, 12">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2">
                        <TextBlock Text="{Binding Nazwa}" FontWeight="Bold"/>
                        <TextBlock>
                            <Run Text="{Binding Kategoria}"/>
                            <Run Text=" - "/>
                            <Run Text="{Binding Cena, StringFormat={}{0:F2} zł}" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" x:Name="UsunProduktButton" Content="Usuń Produkt" Click="UsunProdukt"/>
        <StackPanel Grid.Row="0" Grid.Column="2" Grid.RowSpan="10" Margin="20,0,0,0" DataContext="{Binding SelectedItem, ElementName=ListaProduktow}">
            <TextBlock Text="{Binding Nazwa}" FontSize="18" />
            <TextBlock Text="{Binding Ilosc, StringFormat=Na stanie {0} szt.}" />
            <TextBlock Text="{Binding Cena, StringFormat=Cena: {0:F2} zł}" />
        </StackPanel>
    </Grid>
</Window>
